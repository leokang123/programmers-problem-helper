{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--user-data-dir=/tmp/vscode-pph-a",
        "--extensions-dir=/tmp/vscode-ext-a",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "/tmp/pph-workspace-a"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "prepare isolated extension host"
    }
  ]
}
