{
  "name": "programmers-problem-helper",
  "displayName": "Programmers Problem Helper",
  "description": "Solve Programmers coding-test problems in VS Code with language templates, split previews, and local sample test runs.",
  "version": "0.3.7",
  "publisher": "leokang123",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "programmers",
    "algorithm",
    "algorithms",
    "cpp",
    "c++",
    "java",
    "python",
    "coding-test",
    "competitive-programming",
    "korean"
  ],
  "galleryBanner": {
    "color": "#1e4069",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leokang123/programmers-problem-helper.git"
  },
  "bugs": {
    "url": "https://github.com/leokang123/programmers-problem-helper/issues"
  },
  "homepage": "https://github.com/leokang123/programmers-problem-helper#readme",
  "scripts": {
    "check": "node --check extension.js && node --check src/*.js",
    "package": "npx @vscode/vsce package"
  },
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Programmers Helper",
      "properties": {
        "programmersHelper.language": {
          "type": "string",
          "enum": [
            "cpp",
            "java",
            "python"
          ],
          "enumItemLabels": [
            "C++",
            "Java",
            "Python"
          ],
          "default": "cpp",
          "markdownDescription": "Choose the language used when opening problem solution templates and running tests."
        },
        "programmersHelper.executionMode": {
          "type": "string",
          "enum": [
            "docker",
            "local"
          ],
          "default": "docker",
          "markdownDescription": "Choose whether sample and custom tests run inside the helper Docker container or directly on the local machine. Docker is recommended on Windows. If you use local mode on Windows, install a GNU/Clang-style compiler such as MinGW `g++` or LLVM `clang++` and make sure it is available in PATH."
        },
        "programmersHelper.compilerCommand": {
          "type": "string",
          "enum": [
            "clang++",
            "g++"
          ],
          "default": "clang++",
          "markdownDescription": "Choose the C++ compiler command used for building the generated test runner. Local Windows mode supports `g++` or `clang++`; MSVC `cl.exe` is not supported by the current compile flags."
        },
        "programmersHelper.cppStandard": {
          "type": "string",
          "enum": [
            "c++17",
            "c++20"
          ],
          "default": "c++17",
          "markdownDescription": "Choose the `-std=` flag used when compiling tests."
        },
        "programmersHelper.testTimeoutMs": {
          "type": "number",
          "default": 3000,
          "minimum": 100,
          "markdownDescription": "Set the timeout in milliseconds for each sample or custom test case."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "programmersHelper",
          "title": "Programmers",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "programmersHelper": [
        {
          "id": "programmersHelper.sidebar",
          "type": "webview",
          "name": "Problem Helper",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "programmersHelper.createProblem",
        "title": "Programmers: Create Problem"
      },
      {
        "command": "programmersHelper.runSamples",
        "title": "Programmers: Run Sample Tests"
      },
      {
        "command": "programmersHelper.stopTests",
        "title": "Programmers: Stop Tests"
      },
      {
        "command": "programmersHelper.runCustomTests",
        "title": "Programmers: Run Custom Tests"
      },
      {
        "command": "programmersHelper.openNotes",
        "title": "Programmers: Open Notes"
      }
    ],
    "keybindings": [
      {
        "command": "programmersHelper.runSamples",
        "key": "ctrl+alt+t"
      },
      {
        "command": "programmersHelper.stopTests",
        "key": "ctrl+alt+s"
      }
    ]
  }
}
